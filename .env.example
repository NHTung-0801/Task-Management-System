# =============================================
# File mẫu biến môi trường — KHÔNG chứa secret thật
# Cách dùng: copy thành file .env rồi điền giá trị của bạn
# =============================================

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskmanager
DB_USERNAME=root
DB_PASSWORD=change_me

# --- Backend ---
SERVER_PORT=8080

# --- JWT ---
# Chuỗi bí mật dùng để ký token, tối thiểu 32 ký tự
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Thời gian sống của token (ms) — 86400000 = 24 giờ
JWT_EXPIRATION=86400000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api
